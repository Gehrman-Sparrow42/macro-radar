# ==============================================================================
# YATIRIM RADARI (Investment & Macro Intelligence Terminal) Configuration
# ==============================================================================

# LLM API Keys
# Gemini API Key (Default Free/Flash Layer)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Flagship Reasoning & Copilot Layer)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o
OPENAI_MODEL_REASONING=o1
DEFAULT_MODEL=gemini-flash-latest
LLM_ROUTING_STRATEGY=smart_hybrid

# Database Settings
DATABASE_URL=sqlite:///./macro_radar.db

# Operational Settings
LOG_LEVEL=INFO
DEFAULT_POLL_INTERVAL=3600
MIN_CONTENT_LENGTH=45
